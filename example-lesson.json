    {
      "id": "challenge-1",
      "type": "challenge",
      "title": "Word Problem",
      "content": "<h2 class=\"text-2xl font-bold text-gray-800 mb-4\">🎯 Challenge: Real World Addition</h2><div class=\"bg-gradient-to-r from-orange-50 to-yellow-50 p-6 rounded-xl mb-6 border-2 border-orange-200\"><p class=\"text-lg text-gray-800 leading-relaxed\">Sarah has <strong class=\"text-orange-600\">7 stickers</strong> in her collection. Her friend gives her <strong class=\"text-orange-600\">5 more stickers</strong>. How many stickers does Sarah have now?</p></div><div class=\"bg-blue-50 p-4 rounded-lg mb-6\"><p class=\"text-blue-900 font-medium mb-2\">💭 Think about it:</p><ul class=\"list-disc list-inside text-blue-800 space-y-1\"><li>What numbers do we need to add?</li><li>Are we combining two groups?</li></ul></div><div class=\"text-center\"><label class=\"block text-lg font-semibold mb-3 text-gray-700\">Sarah has <input type=\"number\" id=\"challengeAnswer\" min=\"0\" class=\"w-24 px-4 py-2 border-2 border-gray-300 rounded-lg text-center text-xl font-bold mx-2\" placeholder=\"?\"> stickers now.</label><button onclick=\"checkChallenge()\" class=\"mt-4 bg-purple-500 hover:bg-purple-600 text-white px-8 py-3 rounded-lg transition font-medium\">Submit Answer</button></div><div id=\"challengeFeedback\" class=\"mt-6\"></div>",
      "validation": {
        "type": "exact",
